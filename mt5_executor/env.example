# --- MT5 terminal login -----------------------------------------------
# Your Exness MT5 DEMO account number, password, and server name (shown
# in the MT5 terminal under File > Open an Account, or in your Exness
# Personal Area under the account's details). Start with DEMO values.
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=Exness-MT5Trial
# Only needed if MT5 isn't installed at the default path, or you're
# running multiple terminals side by side. Leave blank to auto-detect
# the already-installed terminal.
MT5_TERMINAL_PATH=

# --- Forex Intel backend -----------------------------------------------
BACKEND_URL=https://forex-intel-production.up.railway.app
# Must match EXECUTOR_API_KEY set on the Railway backend exactly.
EXECUTOR_API_KEY=change-this-to-a-long-random-string

# --- Symbol mapping ------------------------------------------------------
# Exness MT5 symbols are usually the pair with no slash (EURUSD, XAUUSD),
# sometimes with a broker-specific suffix depending on account type
# (e.g. "EURUSDm" on some Exness account types). Check Market Watch in
# your MT5 terminal for the exact spelling and set the suffix here if
# needed — leave blank if symbols have no suffix.
MT5_SYMBOL_SUFFIX=

# --- Polling ------------------------------------------------------------
# How often to check the backend for new executable signals, in seconds.
POLL_INTERVAL_SECONDS=30

# --- Risk & safety limits ------------------------------------------------
# % of current account balance risked on each trade. Position size is
# calculated from this and the signal's own stop-loss distance — same
# pip math already used for the Risk Amount field in the Journal.
RISK_PCT_PER_TRADE=1.0
# Never have more than this many positions open at once, across all
# pairs. New qualifying signals are skipped (not queued) once this is
# hit — see the README for why this is a deliberate simplification.
MAX_CONCURRENT_TRADES=3
# Stop taking new trades for the rest of the trading day once today's
# realized loss reaches this % of the day's starting balance.
DAILY_LOSS_LIMIT_PCT=3.0
# ...or after this many losing trades in a row today, whichever comes
# first. Resets automatically at the next UTC day boundary.
MAX_CONSECUTIVE_LOSSES=3
# Max price slippage allowed on a market order, in broker points.
SLIPPAGE_POINTS=20

# Informational only — included in the order comment and startup log so
# you can tell at a glance which account a given run is pointed at.
# Set to "false" once you've moved this to your live account.
IS_DEMO=true
